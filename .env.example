# Required: Gemini is used by outline, literature and refinement agents.
GEMINI_API_KEY=
# Alternatively, use Vertex AI with Application Default Credentials:
VERTEX_AI_PROJECT=
VERTEX_AI_LOCATION=
# Optional: OpenAI for the pipeline stages that support it.
OPENAI_API_KEY=
# Optional: improves literature search rate limits.
SEMANTIC_SCHOLAR_API_KEY=
# Optional: only needed when requesting email notifications in the UI.
SMTP_EMAIL=
SMTP_PASSWORD=

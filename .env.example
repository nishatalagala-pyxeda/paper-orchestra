# Required for the default OpenAI pipeline (including web search and visual review).
OPENAI_API_KEY=
# Optional: choose another OpenAI model supporting Responses, web search and vision.
PAPER_ORCHESTRA_MODEL=gpt-6-astra
# Optional: improves literature verification rate limits.
SEMANTIC_SCHOLAR_API_KEY=
# Only required if you explicitly select Gemini models:
GEMINI_API_KEY=
VERTEX_AI_PROJECT=
VERTEX_AI_LOCATION=
# Optional email notifications:
SMTP_EMAIL=
SMTP_PASSWORD=

# Optional: local teacher workspace database (default: coaching_data/workspace.sqlite3).
# PAPER_ORCHESTRA_COACH_DB=/absolute/path/to/teacher-workspace.sqlite3
